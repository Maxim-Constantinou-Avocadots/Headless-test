---
import { SITE, NAV } from '../lib/site';
import SubscribeForm from './SubscribeForm.tsx';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-about">
        <h2 class="footer-heading">{SITE.name}</h2>
        <p class="muted">{SITE.tagline}.</p>
        <address>
          {SITE.address.line1}<br />
          {SITE.address.locality}, {SITE.address.postcode}<br />
          <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <h2 class="footer-heading">Pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/apply">Apply to adopt</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
        </ul>
      </nav>

      <div class="footer-subscribe">
        <h2 class="footer-heading">Stay in touch</h2>
        <SubscribeForm client:visible />
      </div>
    </div>

    <p class="footer-legal">
      © {year} {SITE.name}. Registered charity in England and Wales (placeholder number 1099231).
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--cream-deep);
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) 2rem;
  }
  .footer-grid {
    display: grid; gap: clamp(1.75rem, 1rem + 3vw, 3rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 1.1fr .7fr; } }
  @media (min-width: 1000px) { .footer-grid { grid-template-columns: 1.1fr .7fr 1.4fr; } }

  .footer-heading {
    font-size: var(--step-0); font-weight: 700; margin: 0 0 .7rem;
    letter-spacing: .02em;
  }
  address { font-style: normal; line-height: 1.9; font-size: var(--step--1); }
  .footer-nav ul { list-style: none; margin: 0; padding: 0; line-height: 2; font-size: var(--step--1); }
  .footer-nav a, address a { color: var(--ink); text-decoration: none; }
  .footer-nav a:hover, address a:hover { color: var(--teal); text-decoration: underline; }

  .footer-legal {
    margin: 2.5rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--border);
    font-size: var(--step--1); color: var(--ink-soft); max-width: none;
  }
</style>
