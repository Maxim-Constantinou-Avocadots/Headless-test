---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
  /** Set on pages that must never be indexed, e.g. the thank-you pages. */
  noindex?: boolean;
  /** Optional JSON-LD, stringified by the caller. */
  jsonLd?: string;
}

const { noindex = false, jsonLd } = Astro.props;

// Main pages get their title, description, canonical and social tags injected
// automatically from the dashboard's SEO settings, so nothing is hard-coded
// here — a hard-coded tag would compete with the managed one. Item pages fill
// the `seo-tags` slot below instead.
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
    />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <slot name="seo-tags" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
  </head>

  <body>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
