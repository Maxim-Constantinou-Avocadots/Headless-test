---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { resolvePageUrl, type SeoInput } from '../lib/seo';

interface Props {
  /** Title, description and social tags for this page. */
  seo?: SeoInput;
  /** Set on pages that must never be indexed, e.g. the thank-you pages. */
  noindex?: boolean;
  /** Optional JSON-LD, stringified by the caller. */
  jsonLd?: string;
}

const { seo, noindex = false, jsonLd } = Astro.props;
const pageUrl = resolvePageUrl(Astro.request, Astro.url.href);

// These tags are authored here rather than left to Wix's automatic injection.
// That injection only emits anything once a Wix user has configured SEO in the
// dashboard, which on a new site is never — so relying on it ships every page
// with no <title> at all. Passing defaults through @wix/seo's tag service was
// tried first and does not work: the service returns only what the dashboard
// has resolved and ignores supplied fallbacks.
//
// Consequence worth knowing: if a Wix user later configures dashboard SEO for
// a page, its managed tags would be injected alongside these, so remove the
// page's `seo` prop at that point. See README, "Change page titles".
const ogType = seo?.type ?? 'website';
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
    />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {seo && (
      <>
        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <link rel="canonical" href={pageUrl} />

        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:locale" content={SITE.locale} />
        {seo.image && <meta property="og:image" content={seo.image} />}
        {seo.image && <meta property="og:image:alt" content={seo.imageAlt ?? seo.title} />}

        <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={seo.title} />
        <meta name="twitter:description" content={seo.description} />
      </>
    )}

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
  </head>

  <body>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
