---
import Layout from '../layouts/Layout.astro';
import AnimalCard from '../components/AnimalCard.astro';
import Placeholder from '../components/Placeholder.astro';
import { getFeaturedAnimals } from '../lib/animals';
import { getProducts } from '../lib/store';
import { SITE } from '../lib/site';

// Every SSR SDK call is guarded — an unguarded throw truncates the response
// mid-stream and the visitor gets a white screen.
let featured: Awaited<ReturnType<typeof getFeaturedAnimals>> = [];
let featuredFailed = false;
try {
  featured = await getFeaturedAnimals(4);
} catch (err) {
  console.error('[home] featured animals failed', err);
  featuredFailed = true;
}

let shopTeaser: Awaited<ReturnType<typeof getProducts>>['products'] = [];
try {
  const { products } = await getProducts();
  shopTeaser = products.slice(0, 3);
} catch (err) {
  console.error('[home] shop teaser failed', err);
}

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AnimalShelter',
  name: SITE.name,
  description: SITE.description,
  telephone: SITE.phone,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.line1,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postcode,
    addressCountry: SITE.address.countryCode,
  },
});
---

<Layout jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="kicker">Bristol &amp; the South West</p>
        <h1>Every animal here is waiting for someone.</h1>
        <p class="lede">
          {SITE.name} rehomes dogs, cats and rabbits across Bristol and the South West.
          Some have been here a fortnight. Some have been waiting a year. All of them
          are ready.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="/adopt">Meet the animals</a>
          <a class="btn btn--ghost" href="/about">How adopting works</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <Placeholder seed="willowbrook-hero" kind="dog" ratio="5 / 4" />
      </div>
    </div>
  </section>

  <section class="section mission">
    <div class="wrap">
      <h2 class="visually-hidden">Our mission</h2>
      <p class="mission-text">
        We are a small shelter with a simple rule: no animal leaves until we are
        confident the home is right, and no animal is turned away because it is
        old, shy, or needs medicine. We would rather an animal waited another
        month than moved twice.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-heading">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Looking for homes</p>
          <h2 id="featured-heading">Meet a few of them</h2>
        </div>
        <a class="btn btn--ghost btn--sm" href="/adopt">See all animals</a>
      </div>

      {featuredFailed ? (
        <p class="alert alert--warn">
          We could not load the animals just now. Please
          <a href="/adopt"> try the adopt page</a>, or ring us on {SITE.phone}.
        </p>
      ) : featured.length === 0 ? (
        <p class="muted">
          Every animal is currently reserved — a good problem to have.
          <a href="/adopt"> Check the full list</a> for animals arriving soon.
        </p>
      ) : (
        <div class="grid grid--cards">
          {featured.map((animal, i) => <AnimalCard animal={animal} eager={i < 2} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section stats-band" aria-labelledby="stats-heading">
    <div class="wrap">
      <h2 id="stats-heading" class="visually-hidden">Willowbrook in numbers</h2>
      <dl class="stats">
        {SITE.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="shop-heading">
    <div class="wrap shop-teaser">
      <div class="shop-teaser-copy">
        <p class="kicker">The shop</p>
        <h2 id="shop-heading">Buy a tote, feed a dog for a week</h2>
        <p>
          Every penny from the shop goes straight back into food, bedding and
          veterinary bills. No middlemen, no marketing budget.
        </p>
        <a class="btn btn--secondary" href="/shop">Visit the shop</a>
      </div>

      {shopTeaser.length > 0 && (
        <ul class="shop-teaser-items">
          {shopTeaser.map((p) => (
            <li>
              <a href={`/shop/${p.slug}`}>
                {p.image
                  ? <img src={p.image} alt="" width="180" height="180" loading="lazy" decoding="async" />
                  : <Placeholder seed={p.slug} kind="product" ratio="1 / 1" />}
                <span class="shop-teaser-name">{p.name}</span>
                <span class="shop-teaser-price">{p.price}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section closing">
    <div class="wrap center stack">
      <h2>Two ways to help today</h2>
      <p class="lede closing-lede">
        Adopt an animal, or buy something from the shop and fund the ones still
        waiting.
      </p>
      <div class="hero-actions closing-actions">
        <a class="btn btn--primary" href="/adopt">Meet the animals</a>
        <a class="btn btn--ghost" href="/shop">Support the shelter</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { background: linear-gradient(180deg, var(--teal-tint), var(--cream) 78%); }
  .hero-inner {
    display: grid; gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    align-items: center; padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
  }
  @media (min-width: 900px) { .hero-inner { grid-template-columns: 1.05fr .95fr; } }
  .hero h1 { margin-bottom: .5em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .hero-art { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }

  .mission { padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .mission-text {
    font-size: var(--step-2); font-family: var(--font-head); font-weight: 500;
    line-height: 1.4; max-width: 30ch; margin: 0 auto; text-align: center;
    text-wrap: balance; max-inline-size: 34ch;
  }

  .section-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem;
  }
  .section-head h2 { margin: 0; }

  .stats-band { background: var(--teal); color: #fff; }
  .stats {
    display: grid; gap: 1.5rem; margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    text-align: center;
  }
  .stat dd {
    margin: 0; font-family: var(--font-head); font-weight: 700;
    font-size: var(--step-3); line-height: 1.1;
  }
  .stat dt { order: 2; font-size: var(--step--1); opacity: .85; margin-top: .35rem; }
  .stat { display: flex; flex-direction: column; }

  .shop-teaser { display: grid; gap: clamp(1.5rem, 1rem + 2.5vw, 3rem); align-items: center; }
  @media (min-width: 860px) { .shop-teaser { grid-template-columns: 1fr 1.15fr; } }
  .shop-teaser-items {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr);
  }
  .shop-teaser-items a {
    display: flex; flex-direction: column; gap: .4rem; text-decoration: none; color: var(--ink);
  }
  .shop-teaser-items img, .shop-teaser-items :global(.ph) {
    border-radius: var(--radius); aspect-ratio: 1 / 1; object-fit: cover; width: 100%;
    background: var(--cream-deep);
  }
  .shop-teaser-name { font-family: var(--font-head); font-weight: 600; font-size: var(--step--1); }
  .shop-teaser-price { font-size: var(--step--1); color: var(--ink-soft); }

  .closing { background: var(--cream-deep); }
  .closing-lede { margin-inline: auto; }
  .closing-actions { justify-content: center; }
</style>
